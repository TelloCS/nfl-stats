[flake8]
max-line-length = 119
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    */migrations/*,
    venv,
    .venv,
    env,
    .env,
    manage.py,
    settings.py,
    */services/*

# This is the magic part for your Django settings
per-file-ignores =
    # Ignore "star import" and "undefined names" errors only in the settings folder
    backend/settings/*.py: F403, F405